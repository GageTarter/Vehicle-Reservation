# After deploy, browsers must re-fetch index.html so they load the new hashed JS/CSS.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "max-age=0, must-revalidate, no-cache"
  </Files>
  <FilesMatch "\.(js|mjs|css|woff2?|ttf|eot|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vehicles(/.*)?$ http://127.0.0.1:3200/vehicles$1 [P,L]
  RewriteRule ^fleets(/.*)?$ http://127.0.0.1:3200/fleets$1 [P,L]
  RewriteRule ^driverapi(/.*)?$ http://127.0.0.1:3200/driverapi$1 [P,L]
  RewriteRule ^vehicleapi(/.*)?$ http://127.0.0.1:3200/vehicleapi$1 [P,L]
  RewriteRule ^api(/.*)?$ http://127.0.0.1:3200/api$1 [P,L]
  RewriteBase /seiv2026/p4/t5/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /seiv2026/p4/t5/index.html [L]
</IfModule>
